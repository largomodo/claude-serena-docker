ARG BASE_TAG=latest
FROM claude-env-base:${BASE_TAG}

USER root

ENV VASM_URL=http://sun.hasenbraten.de/vasm/release/vasm.tar.gz
ENV VLINK_URL=http://sun.hasenbraten.de/vlink/release/vlink.tar.gz

# JDK pins are ARG defaults, kept in step with the other ARG-default JDK pin
# sites (Dockerfile.x86, Dockerfile.snes, Dockerfile.kicad); a JDK bump edits all of them.
# The JDK exists here only for Ghidra, which REA's raw-binary m68k mode drives.
# The pinned Ghidra declares no maximum Java version and runs on JDK 25
# (upstream issue #9495). REA compiles its Ghidra bridge with this JDK's
# javac, so the full JDK (not a JRE) is required.
ARG JAVA_LANG_VERSION=25
ARG ADOPTIUM_VERSION=25.0.4.1
ARG ADOPTIUM_BUILD=1

# Ghidra and REA pins come from the x-ghidra-toolchain and x-rea-toolchain
# anchors in docker-compose.yml, shared with x86 and snes. No defaults here:
# a bare `docker build` fails in the install scripts' argument check instead
# of fetching an unverified or unpinned download.
ARG GHIDRA_VERSION
ARG GHIDRA_DATE
ARG GHIDRA_SHA256
ARG REA_VERSION

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    mame \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# VASM: CPU=m68k SYNTAX=mot produces vasmm68k_mot; CPU=z80 SYNTAX=mot produces vasmz80_mot.
RUN set -eux; \
    mkdir -p /tmp/vasm; \
    curl -L -o /tmp/vasm.tar.gz "$VASM_URL"; \
    tar -xzf /tmp/vasm.tar.gz -C /tmp/vasm --strip-components=1; \
    make -C /tmp/vasm CPU=m68k SYNTAX=mot; \
    cp /tmp/vasm/vasmm68k_mot /usr/local/bin/; \
    make -C /tmp/vasm clean; \
    make -C /tmp/vasm CPU=z80 SYNTAX=mot; \
    cp /tmp/vasm/vasmz80_mot /usr/local/bin/; \
    rm -rf /tmp/vasm /tmp/vasm.tar.gz

RUN set -eux; \
    mkdir -p /tmp/vlink; \
    curl -L -o /tmp/vlink.tar.gz "$VLINK_URL"; \
    tar -xzf /tmp/vlink.tar.gz -C /tmp/vlink --strip-components=1; \
    make -C /tmp/vlink; \
    cp /tmp/vlink/vlink /usr/local/bin/; \
    rm -rf /tmp/vlink /tmp/vlink.tar.gz

# Ghidra + REA: static analysis of built ROMs and headerless 68000 images
# (REA's raw-binary mode maps a P-ROM at a caller-supplied base address and
# returns functions, instructions, pseudocode and xrefs over MCP). The shared
# scripts own the download and verification procedures.
COPY resources/snippets/shared/install-jdk.sh /usr/local/share/claude-env/install/install-jdk.sh
COPY resources/snippets/shared/install-ghidra.sh /usr/local/share/claude-env/install/install-ghidra.sh
COPY resources/snippets/shared/install-rea.sh /usr/local/share/claude-env/install/install-rea.sh

RUN bash /usr/local/share/claude-env/install/install-jdk.sh "${JAVA_LANG_VERSION}" "${ADOPTIUM_VERSION}" "${ADOPTIUM_BUILD}"

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN bash /usr/local/share/claude-env/install/install-ghidra.sh "${GHIDRA_VERSION}" "${GHIDRA_DATE}" "${GHIDRA_SHA256}"

RUN bash /usr/local/share/claude-env/install/install-rea.sh "${REA_VERSION}"

COPY resources/config/serena_config.auto.yml /usr/local/share/claude-env/serena_config.yml
RUN chown codeuser:codeuser /usr/local/share/claude-env/serena_config.yml

# Tool sheet + notes: concatenated with base.md and verified by check-tools.sh.
COPY --chown=codeuser:codeuser resources/tools/68k.md /usr/local/share/claude-env/tools/68k.md
COPY --chown=codeuser:codeuser resources/tools/rea-notes.md /usr/local/share/claude-env/tools/rea-notes.md

USER codeuser

ENV VARIANT=68k
# The Debian mame package installs its binary under /usr/games, which is not
# on the default PATH; append it so `mame` resolves for agents and for check-tools.sh.
ENV PATH="${PATH}:/usr/games"
# REA's Ghidra provider locates the installation through this variable (it
# otherwise searches PATH for ghidraRun, which this image does not link).
ENV GHIDRA_INSTALL_DIR=/opt/ghidra

# The sheet is imported into every agent session via ~/.claude/claude-env.md;
# the check keeps it honest. Must stay the last RUN, after USER codeuser and
# after every ENV line, so the check sees VARIANT and GHIDRA_INSTALL_DIR.
RUN cat /usr/local/share/claude-env/tools/base.md /usr/local/share/claude-env/tools/68k.md > /usr/local/share/claude-env/claude-env.md && \
    check-tools.sh /usr/local/share/claude-env/claude-env.md

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD claude --version && python --version && vasmm68k_mot >/dev/null && rea --version \
        && test -f /opt/ghidra/Ghidra/Processors/68000/data/languages/68040.sla || exit 1
