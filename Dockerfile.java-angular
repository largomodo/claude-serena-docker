ARG BASE_TAG=latest
FROM claude-env-base:${BASE_TAG}

# Merges the java variant's toolchain with the Angular CLI for fullstack
# Angular+Java work (ng serve on 4200 proxying /api to a backend on 8080).
# The Java toolchain is the shared install scripts under
# resources/snippets/shared invoked with the anchor's pins, rather than
# layering FROM claude-env-java: java-docker already can't inherit from
# both java and image-dev, so layering here would make this file an
# inconsistent exception -- the flat one-Dockerfile-per-variant convention
# holds. (ref: DL-003, DL-010 in plan-docker-angular-implementation.md)
# Java/JDT-LS version pins come from the x-java-toolchain anchor in
# docker-compose.yml (single source of truth across java, java-docker,
# java-angular).

USER root

# Java 25 LTS configuration
# Values come from the x-java-toolchain anchor in docker-compose.yml (single
# source of truth across java, java-docker, java-angular). (ref: DL-001 in plan-docker-angular-implementation.md)
# Builds go through
# ./build.sh -- a bare `docker build` has no versions and fails the guard below.
ARG JAVA_LANG_VERSION
ARG ADOPTIUM_VERSION
ARG ADOPTIUM_BUILD

# Eclipse JDT LS configuration
ARG JDTLS_VERSION
ARG JDTLS_TIMESTAMP
# JDTLS_SHA256 is pinned in the compose anchor: the .sha256 file beside the tarball shares its origin.
ARG JDTLS_SHA256

# Lombok agent for JDT-LS upstream mode; the digest comes from the compose anchor.
ARG LOMBOK_VERSION
ARG LOMBOK_SHA256

# Fails fast on an out-of-compose build rather than silently drifting from
# the anchor with a stale default. (ref: DL-002 in plan-docker-angular-implementation.md)
RUN test -n "${JAVA_LANG_VERSION}" && test -n "${ADOPTIUM_VERSION}" && test -n "${ADOPTIUM_BUILD}" \
    && test -n "${JDTLS_VERSION}" && test -n "${JDTLS_TIMESTAMP}" && test -n "${JDTLS_SHA256}" \
    && test -n "${LOMBOK_VERSION}" && test -n "${LOMBOK_SHA256}" \
    || { echo "ERROR: Java toolchain ARGs unset -- build via ./build.sh (compose provides them)"; exit 1; }

# apt maven depends on openjdk-25-jre-headless, which installs under
# /usr/lib/jvm. The Temurin JDK at /opt/java/openjdk is the only javac JDK;
# the ENV PATH line below keeps it first so `java` resolves to Temurin.
RUN apt-get update && \
    apt-get install -y maven \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Plain COPY then RUN keeps the scripts in the image under /usr/local/share/claude-env/install/
# and avoids BuildKit-only syntax (bind-mount RUN) so any builder works.
COPY resources/snippets/shared/install-jdk.sh resources/snippets/shared/install-jdtls.sh resources/snippets/shared/install-lombok.sh /usr/local/share/claude-env/install/

# Bash invocation and the ENV lines below: see the install-jdk.sh header.
RUN bash /usr/local/share/claude-env/install/install-jdk.sh "${JAVA_LANG_VERSION}" "${ADOPTIUM_VERSION}" "${ADOPTIUM_BUILD}"

ENV JAVA_HOME=/opt/java/openjdk
# Shadows the apt-pulled openjdk-25-jre-headless (/usr/lib/jvm) on PATH.
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN bash /usr/local/share/claude-env/install/install-jdtls.sh "${JDTLS_VERSION}" "${JDTLS_TIMESTAMP}" "${JDTLS_SHA256}"

# Serena's upstream JDT-LS mode needs jdtls_path and lombok_path together;
# otherwise it downloads the vscode-java bundle into $SERENA_HOME. Lombok lives
# at /opt/lombok, beside /opt/jdtls, because ~/.m2 is bind-mounted at runtime
# and would shadow an image-side copy.
RUN bash /usr/local/share/claude-env/install/install-lombok.sh "${LOMBOK_VERSION}" "${LOMBOK_SHA256}"

RUN chown -R codeuser:codeuser /opt/jdtls /opt/lombok

# Node 24 LTS is variant-local at /opt/node and shadows the base image's apt
# Node 22.x via PATH (apt nodejs/npm stay installed but unreferenced; other
# variants keep using them). Angular 22's engine check (Node ^22.22.3 ||
# ^24.15.0 || ^26.0.0) rejects apt's 22.22.1, and the check applies to
# project-local CLIs too -- no pin-level workaround exists. Pinned via the
# NODE_VERSION compose arg. (ref: DL-013 in plan-docker-angular-implementation.md)
ARG NODE_VERSION
ARG NODE_DIST="node-v${NODE_VERSION}-linux-x64"
ARG NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/${NODE_DIST}.tar.gz"
ARG NODE_CHECKSUM_URL="https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"

RUN test -n "${NODE_VERSION}" || { echo "ERROR: NODE_VERSION unset -- build via ./build.sh"; exit 1; }

# SHASUMS256.txt covers ~30 release assets per Node version, unlike the JDK's
# single-asset checksum file rewritten in place above -- grep isolates the
# line for this exact tarball before piping it to sha256sum -c, so the
# verification cannot pass against the wrong asset.
RUN set -eux; \
    curl -L -o SHASUMS256.txt "${NODE_CHECKSUM_URL}"; \
    curl -L -o "${NODE_DIST}.tar.gz" "${NODE_URL}"; \
    grep " ${NODE_DIST}.tar.gz$" SHASUMS256.txt | sha256sum -c -; \
    mkdir -p /opt/node; \
    tar -xzf "${NODE_DIST}.tar.gz" -C /opt/node --strip-components=1; \
    rm "${NODE_DIST}.tar.gz" SHASUMS256.txt

# ENV PATH sits before the Angular CLI install below so the bundled npm 11
# performs it and the global CLI lands under /opt/node -- nothing touches the
# apt npm's prefix. The /opt/node/bin additions (node, npm, npx, corepack,
# and the ng shim) collide with nothing already on PATH: the base image's
# cli-tools venv (/opt/cli-tools/.venv/bin) and Serena venv
# (/home/codeuser/serena/.venv/bin) carry no same-named binaries, so
# prepending /opt/node/bin here shadows only the apt nodejs/npm package.
ENV PATH="/opt/node/bin:${PATH}"

# /opt/node stays root-owned (unlike /opt/jdtls) -- codeuser only reads and
# executes it. Runtime global installs must use the absolute path
# `sudo /opt/node/bin/npm install -g`: the codeuser sudoers entry carries no
# secure_path override, so sudo applies Ubuntu's default secure_path, which
# excludes /opt/node/bin and resets PATH for the sudo'd command. A bare
# `sudo npm install -g` would silently resolve the apt npm at /usr/bin/npm
# instead. (ref: DL-013 in plan-docker-angular-implementation.md)

# Angular CLI -- the one global npm install, pinned to a major via the
# ANGULAR_CLI_VERSION service arg, outside the shared x-java-toolchain anchor. Inside a project, `ng` delegates to the
# project-local CLI, so a pinned-major global CLI never breaks projects;
# scaffolding other majors goes through `npx @angular/cli@<major>`. No browser
# is baked in -- unit tests run under Vitest + jsdom. (ref: DL-004, DL-005 in plan-docker-angular-implementation.md)
ARG ANGULAR_CLI_VERSION

RUN test -n "${ANGULAR_CLI_VERSION}" || { echo "ERROR: ANGULAR_CLI_VERSION unset -- build via ./build.sh"; exit 1; }

# `npm` here resolves to /opt/node/bin/npm because ENV PATH above already put
# /opt/node/bin first -- the install lands under /opt/node, not the apt npm
# prefix.
RUN npm install -g @angular/cli@${ANGULAR_CLI_VERSION} && ng version

# java-angular shares the java template: its only Java-specific keys are the
# JDT-LS paths, and the Angular LS is SolidLSP-managed with no config entry.
COPY resources/config/serena_config.java.yml /usr/local/share/claude-env/serena_config.yml
RUN chown codeuser:codeuser /usr/local/share/claude-env/serena_config.yml

# Tool sheet: concatenated with base.md and verified by check-tools.sh.
COPY --chown=codeuser:codeuser resources/tools/java-angular.md /usr/local/share/claude-env/tools/java-angular.md
COPY --chown=codeuser:codeuser resources/tools/java-angular-notes.md /usr/local/share/claude-env/tools/java-angular-notes.md

USER codeuser

ENV VARIANT=java-angular

# /opt/node/bin is already on PATH from the ENV PATH line above, so `ng`
# and the Node 24 binaries resolve for the check. Must stay the last RUN,
# after USER codeuser and after every ENV line. The sheet is
# imported into every agent session; the check keeps it honest.
RUN cat /usr/local/share/claude-env/tools/base.md /usr/local/share/claude-env/tools/java-angular.md > /usr/local/share/claude-env/claude-env.md && \
    check-tools.sh /usr/local/share/claude-env/claude-env.md

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD claude --version && java --version && ng version && python --version || exit 1
