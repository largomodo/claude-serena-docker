# Dockerfile.base -- shared infrastructure layer for all claude-env variants.
# Builds claude-env-base:<tag>. Variant Dockerfiles (Dockerfile.<variant>)
# FROM this image and add domain-specific toolchains.
FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

ARG USER_UID=1000
ARG USER_GID=1000

RUN apt-get update && \
    apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    nodejs \
    npm \
    git \
    curl \
    wget \
    build-essential \
    ca-certificates \
    gnupg \
    lsb-release \
    vim \
    jq \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# build-essential provides gcc/g++/make; variant Dockerfiles must not reinstall those.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    poppler-utils \
    pandoc \
    sqlite3 \
    graphviz \
    tesseract-ocr \
    shellcheck \
    ripgrep \
    fd-find \
    tree \
    unzip \
    zip \
    xz-utils \
    file \
    less \
    man-db \
    postgresql-client \
    imagemagick \
    ffmpeg \
    net-tools \
    dnsutils \
    iputils-ping \
    traceroute \
    strace \
    htop \
    ncdu \
    sudo \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Passwordless sudo for on-demand tool installs; acceptable for single-user local dev containers only.
RUN echo "codeuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/codeuser && \
    chmod 0440 /etc/sudoers.d/codeuser

RUN ln -sf /usr/bin/python3 /usr/bin/python

# Create non-root user with matching UID/GID
RUN if [ "${USER_UID}" = "1000" ]; then \
        groupmod -n codeuser -g ${USER_GID} ubuntu && \
        usermod -d /home/codeuser -l codeuser -u ${USER_UID} -g codeuser ubuntu && \
        mv /home/ubuntu /home/codeuser; \
    else \
        groupadd -g ${USER_GID} codeuser && \
        useradd -m -d /home/codeuser -u ${USER_UID} -g ${USER_GID} -s /bin/bash codeuser; \
    fi

# UV_INSTALL_DIR=/usr/local/bin makes uv available to both root and codeuser without PATH gymnastics.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Isolated venv keeps cli-tools dependencies separate from Serena to prevent conflicts.
# trafilatura replaces the built-in WebFetch tool (denied in managed-settings.json):
# `trafilatura -u <url> --markdown` extracts main text locally with no summarizing model.
# Unpinned on purpose: every build takes the latest release; trafilatura-ua.sh (further
# down) patches one line of it and fails the build loudly if that line ever moves.
RUN mkdir -p /opt/cli-tools && \
    uv venv /opt/cli-tools/.venv && \
    uv pip install \
        --python /opt/cli-tools/.venv/bin/python \
        httpie \
        yq \
        csvkit \
        litecli \
        pgcli \
        trafilatura && \
    chmod -R a+rX /opt/cli-tools

USER codeuser
WORKDIR /home/codeuser

# cli-tools/.venv/bin listed first so CLI tool binaries shadow conflicting names.
ENV PATH="/opt/cli-tools/.venv/bin:/home/codeuser/.local/bin:/home/codeuser/.cargo/bin:${PATH}"

RUN curl -fsSL https://claude.ai/install.sh | bash
ENV DISABLE_AUTOUPDATER=1

RUN rm -f /home/codeuser/.claude.json

RUN git clone https://github.com/oraios/serena.git

WORKDIR /home/codeuser/serena
RUN uv venv && \
    . .venv/bin/activate && \
    uv pip install -r pyproject.toml -e .

USER root

RUN mkdir -p /usr/local/share/claude-env

# Serena config is staged here; each variant Dockerfile COPYs its own variant-specific config at build time.
COPY resources/config/.bash_aliases /usr/local/share/claude-env/.bash_aliases

RUN chown -R codeuser:codeuser /usr/local/share/claude-env

# Managed settings: Claude Code reads /etc/claude-code/managed-settings.json
# on every startup (built-in Linux path, nothing to enable). It outranks the
# user settings.json in the bind-mounted ~/.claude, so these defaults hold
# regardless of what the persisted config or /config toggles contain.
COPY resources/config/managed-settings.json /etc/claude-code/managed-settings.json
RUN chmod 644 /etc/claude-code/managed-settings.json

# trafilatura default user agent: current Chrome major, looked up at build time
# and written into the installed package (one line of downloads.py plus the
# USER_AGENTS option in settings.cfg; see the script header for why the config
# file alone is not enough). TRAFILATURA_UA_REFRESH is a cache-buster (build.sh
# passes the epoch) so this layer re-runs on every build; it sits this late so
# nothing expensive follows it. TRAFILATURA_UA_PATCH=skip builds without the
# patch if upstream changes the line before this script is updated.
COPY resources/scripts/trafilatura-ua.sh /usr/local/bin/trafilatura-ua.sh
# web-fetch.sh is the one-call front end the web-fetch skill uses: live fetch,
# curl with the same Chrome UA, then the newest Internet Archive snapshot, with
# a status line naming the stage that succeeded and the snapshot date.
COPY resources/scripts/web-fetch.sh /usr/local/bin/web-fetch.sh
ARG TRAFILATURA_UA_REFRESH=0
ARG TRAFILATURA_UA_PATCH=
RUN TRAFILATURA_UA_PATCH="${TRAFILATURA_UA_PATCH}" /usr/local/bin/trafilatura-ua.sh /opt/cli-tools/.venv/bin/python

USER codeuser
RUN cp /usr/local/share/claude-env/.bash_aliases /home/codeuser/.bash_aliases

RUN rm -rf /home/codeuser/.serena /home/codeuser/.claude

WORKDIR /home/codeuser

COPY --chown=codeuser:codeuser resources/scripts/init-workspace.sh /home/codeuser/init-workspace.sh
RUN chmod +x /home/codeuser/init-workspace.sh

USER root
RUN mkdir -p /workspace && chown -R codeuser:codeuser /workspace

USER codeuser
WORKDIR /workspace

ENV PATH="/home/codeuser/serena/.venv/bin:${PATH}"
ENV SERENA_HOME="/home/codeuser/serena"
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["/home/codeuser/init-workspace.sh"]
