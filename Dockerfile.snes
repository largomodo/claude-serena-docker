ARG BASE_TAG=latest
FROM claude-env-base:${BASE_TAG}

USER root

ARG JAVA_LANG_VERSION=25
ARG ADOPTIUM_VERSION=25.0.4.1
ARG ADOPTIUM_BUILD=1

# ghidra-snes-loader's Gradle 8.5 wrapper cannot run on JDK 25 (Gradle 9.1+
# needed), so the extension builds on a JDK 21 that never reaches the image.
# Drop these ARGs once a SnesLoader release ships a Gradle 9.1+ wrapper.
# The build JVM executes downloaded Gradle
# code, so it carries current security fixes. Like the image JDK it is a
# 4-component respin that resolves through the same URL template.
ARG GRADLE_JDK_LANG_VERSION=21
ARG GRADLE_JDK_VERSION=21.0.12.1
ARG GRADLE_JDK_BUILD=1

# Ghidra pins come from the x-ghidra-toolchain anchor in docker-compose.yml,
# shared with x86 and 68k. No defaults here: a bare `docker build` fails in
# the install script's argument check instead of fetching an unverified zip.
ARG GHIDRA_VERSION
ARG GHIDRA_DATE
ARG GHIDRA_SHA256

# SNES loader extension and 65816 processor module: tags pinned in the snes
# service args of docker-compose.yml (both repos ship releases since
# 2026-02-28; v0.1.0 targets Ghidra 12.0.3 and builds against 12.1.4).
ARG SNES_LOADER_REPO=https://github.com/ViewtifulSlayer/ghidra-snes-loader.git
ARG SNES_LOADER_REF
ARG GHIDRA_65816_REPO=https://github.com/ViewtifulSlayer/ghidra-65816.git
ARG GHIDRA_65816_REF

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    nasm \
    radare2 \
    upx-ucl \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# The JDK pins are ARG defaults in this file; the shared scripts own the
# download and verification procedures.
COPY resources/snippets/shared/install-jdk.sh /usr/local/share/claude-env/install/install-jdk.sh
COPY resources/snippets/shared/install-ghidra.sh /usr/local/share/claude-env/install/install-ghidra.sh

RUN bash /usr/local/share/claude-env/install/install-jdk.sh "${JAVA_LANG_VERSION}" "${ADOPTIUM_VERSION}" "${ADOPTIUM_BUILD}"

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN bash /usr/local/share/claude-env/install/install-ghidra.sh "${GHIDRA_VERSION}" "${GHIDRA_DATE}" "${GHIDRA_SHA256}"

# Build SNES/65816 toolchain: loader extension + processor module + Sleigh compilation.
# Nested SnesLoader extraction guard prevents double-nesting on re-run.
# The 65816.cspec patch: Ghidra 12.1 dropped the `type` attribute of
# <prototype> from compiler_spec.rxg, and ghidra-65816 v0.1.0 (written for
# 12.0.3) still carries type="unknown" on its __unknowncall prototype. The
# validator then rejects the cspec at import ("unexpected attribute type")
# and every 65816 import fails with 'Compiler spec "default" is not
# supported'. The grep guard fails the build once upstream drops the
# attribute, so this patch is removed rather than left matching nothing.
# The gradlew step runs on a throwaway JDK 21 in /tmp/gradle-jdk, installed
# and deleted inside this RUN so it never reaches an image layer.
# Ghidra's compiler level is 21, so the built extension loads on the image's JDK 25.
RUN set -eux; \
    test -n "${SNES_LOADER_REF}" && test -n "${GHIDRA_65816_REF}" || { echo "ERROR: SNES_LOADER_REF / GHIDRA_65816_REF are empty -- pins live in the snes service args of docker-compose.yml"; exit 1; }; \
    bash /usr/local/share/claude-env/install/install-jdk.sh "${GRADLE_JDK_LANG_VERSION}" "${GRADLE_JDK_VERSION}" "${GRADLE_JDK_BUILD}" /tmp/gradle-jdk; \
    git clone --depth 1 --branch "${SNES_LOADER_REF}" "${SNES_LOADER_REPO}" /tmp/ghidra-snes-loader; \
    cd /tmp/ghidra-snes-loader/SnesLoader; \
    JAVA_HOME=/tmp/gradle-jdk GHIDRA_INSTALL_DIR=/opt/ghidra ./gradlew buildExtension; \
    mkdir -p /opt/ghidra/Ghidra/Extensions/SnesLoader; \
    unzip -q dist/ghidra_*_SnesLoader.zip -d /opt/ghidra/Ghidra/Extensions/SnesLoader; \
    if [ ! -f /opt/ghidra/Ghidra/Extensions/SnesLoader/extension.properties ]; then \
        NESTED=$(find /opt/ghidra/Ghidra/Extensions/SnesLoader -name extension.properties | head -1); \
        if [ -z "$NESTED" ]; then \
            echo "ERROR: extension.properties not found after extraction"; exit 1; \
        fi; \
        NESTED_DIR=$(dirname "$NESTED"); \
        mv "$NESTED_DIR"/* /opt/ghidra/Ghidra/Extensions/SnesLoader/; \
        rm -rf "$NESTED_DIR"; \
    fi; \
    git clone --depth 1 --branch "${GHIDRA_65816_REF}" "${GHIDRA_65816_REPO}" /tmp/ghidra-65816; \
    cp -r /tmp/ghidra-65816 /opt/ghidra/Ghidra/Processors/65816; \
    CSPEC=/opt/ghidra/Ghidra/Processors/65816/data/languages/65816.cspec; \
    grep -q ' type="unknown"' "$CSPEC" || { echo "ERROR: 65816.cspec no longer carries type=\"unknown\" -- upstream fixed it for Ghidra 12.1; drop this sed patch from Dockerfile.snes"; exit 1; }; \
    sed -i 's/ type="unknown"//' "$CSPEC"; \
    /opt/ghidra/support/sleigh /opt/ghidra/Ghidra/Processors/65816/data/languages/65816.slaspec; \
    mkdir -p /opt/ghidra/Ghidra/Scripts; \
    rm -rf /tmp/ghidra-snes-loader /tmp/ghidra-65816 /tmp/gradle-jdk /root/.gradle \
           /opt/ghidra/Ghidra/Processors/65816/.git

RUN chown -R codeuser:codeuser /opt/ghidra

RUN uv pip install --python /opt/cli-tools/.venv/bin/python capstone pefile

COPY resources/snippets/shared/dis16.sh /usr/local/bin/dis16
COPY resources/snippets/shared/r216.sh /usr/local/bin/r216
COPY resources/snippets/shared/dump16.sh /usr/local/bin/dump16
COPY resources/snippets/snes/snes-analyze.sh /usr/local/bin/snes-analyze
COPY resources/snippets/snes/SetSnesRegisters.java /opt/ghidra/Ghidra/Scripts/SetSnesRegisters.java
COPY resources/snippets/snes/SeedSnesVectors.java /opt/ghidra/Ghidra/Scripts/SeedSnesVectors.java
COPY resources/snippets/snes/DumpInfo.java /opt/ghidra/Ghidra/Scripts/DumpInfo.java
RUN chmod +x /usr/local/bin/dis16 /usr/local/bin/r216 /usr/local/bin/dump16 /usr/local/bin/snes-analyze

# Binary-analysis variants create no Serena project (init-workspace.sh exits
# early), so the auto template is sufficient.
COPY resources/config/serena_config.auto.yml /usr/local/share/claude-env/serena_config.yml
RUN chown codeuser:codeuser /usr/local/share/claude-env/serena_config.yml

# Tool sheet + notes: concatenated with base.md and verified by check-tools.sh.
COPY --chown=codeuser:codeuser resources/tools/snes.md /usr/local/share/claude-env/tools/snes.md
COPY --chown=codeuser:codeuser resources/tools/snes-notes.md /usr/local/share/claude-env/tools/snes-notes.md

USER codeuser

ENV VARIANT=snes
ENV GHIDRA_SCRIPTS_DIR=/opt/ghidra/Ghidra/Scripts
ENV GHIDRA_PROJECTS_DIR=/workspace/.ghidra-projects

# Both GHIDRA_* variables above must precede this RUN so the check sees
# them. Must stay the last RUN, after USER codeuser and after every ENV
# line. The sheet is imported into every agent session; the check
# keeps it honest.
RUN cat /usr/local/share/claude-env/tools/base.md /usr/local/share/claude-env/tools/snes.md > /usr/local/share/claude-env/claude-env.md && \
    check-tools.sh /usr/local/share/claude-env/claude-env.md

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD test -f /opt/ghidra/Ghidra/Processors/65816/data/languages/65816.sla \
        && test -f /opt/ghidra/Ghidra/Extensions/SnesLoader/extension.properties \
        && claude --version && python --version || exit 1
