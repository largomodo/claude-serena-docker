ARG BASE_TAG=latest
FROM claude-env-base:${BASE_TAG}

USER root

ARG JAVA_LANG_VERSION=21
ARG ADOPTIUM_VERSION=21.0.10
ARG ADOPTIUM_BUILD=7

ARG GHIDRA_VERSION=12.0.4
ARG GHIDRA_DATE=20260303
ARG GHIDRA_SHA256="c3b458661d69e26e203d739c0c82d143cc8a4a29d9e571f099c2cf4bda62a120"
ARG GHIDRA_URL="https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_DATE}.zip"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    nasm \
    radare2 \
    upx-ucl \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# GHIDRA_SHA256 has a pinned default, so the only way to skip verification is
# an empty --build-arg; this guard fails the build before any download instead
# of letting an unverified Ghidra download proceed.
# The Ghidra ARG pins are duplicated in Dockerfile.x86 and Dockerfile.snes on
# purpose (dedupe into a shared script deferred); bump both together.
RUN test -n "${GHIDRA_SHA256}" || { echo "ERROR: GHIDRA_SHA256 is empty -- the Ghidra download is always checksum-verified; keep the pinned digest or pass the digest for the release you pin"; exit 1; }

# The JDK pins are ARG defaults in this file; the shared script owns the
# download and verification procedure.
COPY resources/snippets/shared/install-jdk.sh /usr/local/share/claude-env/install/install-jdk.sh

RUN bash /usr/local/share/claude-env/install/install-jdk.sh "${JAVA_LANG_VERSION}" "${ADOPTIUM_VERSION}" "${ADOPTIUM_BUILD}"

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

RUN set -eux; \
    curl -L -o /tmp/ghidra.zip "${GHIDRA_URL}"; \
    echo "${GHIDRA_SHA256}  /tmp/ghidra.zip" | sha256sum -c -; \
    unzip -q /tmp/ghidra.zip -d /opt; \
    mv /opt/ghidra_${GHIDRA_VERSION}_PUBLIC /opt/ghidra; \
    rm /tmp/ghidra.zip; \
    ln -s /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless

RUN chown -R codeuser:codeuser /opt/ghidra

RUN uv pip install --python /opt/cli-tools/.venv/bin/python capstone pefile

COPY resources/snippets/shared/dis16.sh /usr/local/bin/dis16
COPY resources/snippets/shared/r216.sh /usr/local/bin/r216
COPY resources/snippets/shared/dump16.sh /usr/local/bin/dump16
RUN chmod +x /usr/local/bin/dis16 /usr/local/bin/r216 /usr/local/bin/dump16

# Binary-analysis variants create no Serena project (init-workspace.sh exits
# early), so the auto template is sufficient.
COPY resources/config/serena_config.auto.yml /usr/local/share/claude-env/serena_config.yml
RUN chown codeuser:codeuser /usr/local/share/claude-env/serena_config.yml

# Tool sheet: concatenated with base.md and verified by check-tools.sh.
COPY --chown=codeuser:codeuser resources/tools/x86.md /usr/local/share/claude-env/tools/x86.md

USER codeuser

ENV VARIANT=x86

# The sheet is imported into every agent session via ~/.claude/claude-env.md;
# the check keeps it honest. Must stay the last RUN, after USER codeuser and
# after every ENV line, so the check sees VARIANT.
RUN cat /usr/local/share/claude-env/tools/base.md /usr/local/share/claude-env/tools/x86.md > /usr/local/share/claude-env/claude-env.md && \
    check-tools.sh /usr/local/share/claude-env/claude-env.md

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ndisasm -v && r2 -v && python --version && test -f /opt/ghidra/Ghidra/Processors/x86/data/languages/x86-16.sla || exit 1
