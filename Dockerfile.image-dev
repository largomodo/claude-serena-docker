ARG BASE_TAG=latest
FROM claude-env-base:${BASE_TAG}

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    uidmap \
    dbus-user-session \
    fuse-overlayfs \
    slirp4netns \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN curl -fsSL https://get.docker.com | sh && \
    apt-get install -y --no-install-recommends docker-compose-plugin && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

RUN echo "codeuser:100000:65536" >> /etc/subuid && \
    echo "codeuser:100000:65536" >> /etc/subgid && \
    mkdir -p /home/codeuser/.local/share/docker && \
    chown -R codeuser:codeuser /home/codeuser/.local

COPY resources/config/serena_config.auto.yml /usr/local/share/claude-env/serena_config.yml
RUN chown codeuser:codeuser /usr/local/share/claude-env/serena_config.yml

# Tool sheet: concatenated with base.md and verified by check-tools.sh.
COPY --chown=codeuser:codeuser resources/tools/image-dev.md /usr/local/share/claude-env/tools/image-dev.md

# start-dockerd.sh is generic (no image-dev-specific paths) and is shared
# with the java-docker variant.
COPY resources/scripts/start-dockerd.sh /home/codeuser/start-dockerd.sh
RUN chmod +x /home/codeuser/start-dockerd.sh

USER codeuser

ENV VARIANT=image-dev
ENV DOCKER_HOST=unix:///run/user/1000/docker.sock
ENV XDG_RUNTIME_DIR=/run/user/1000

# DOCKER_HOST and XDG_RUNTIME_DIR above must precede this RUN so the check
# sees them. Must stay the last RUN, after USER codeuser and after every
# ENV line. The sheet is imported into every agent session; the
# check keeps it honest.
RUN cat /usr/local/share/claude-env/tools/base.md /usr/local/share/claude-env/tools/image-dev.md > /usr/local/share/claude-env/claude-env.md && \
    check-tools.sh /usr/local/share/claude-env/claude-env.md

ENTRYPOINT ["/home/codeuser/start-dockerd.sh"]

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD docker info >/dev/null 2>&1 && claude --version && python --version || exit 1
